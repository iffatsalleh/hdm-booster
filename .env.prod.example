# Copy to .env.prod (gitignored, never commit it):  copy .env.prod.example .env.prod
# Read by scripts/migrate.mjs, scripts/setup.mjs and scripts/smoke.mjs.

# REQUIRED. HornetHive pooled Postgres string (PgBouncer, port 6432, sslmode=require). Used by migrations,
# DB tests, setup.mjs and as the Hyperdrive origin:
#   npx wrangler hyperdrive create hdm-db --connection-string="<HIVE_PG_URL>" --caching-disabled
# It acts as the database owner: never put it in the Blogspot template, Apps Script or a chat.
HIVE_PG_URL=

# GENERATED by `node scripts/setup.mjs secrets` (leave empty here). The same INTERNAL_SECRET and TICKET_SECRET
# go to the Worker (wrangler secret) and to Apps Script (Script Properties). BCL_WEBHOOK_KEY is Apps Script only.
INTERNAL_SECRET=
TICKET_SECRET=
BCL_WEBHOOK_KEY=

# OPTIONAL. HornetHive REST fallback only (used by the Worker when no [[hyperdrive]] binding is configured,
# e.g. if HornetHive stops allowing the direct connection on the Free plan). Not needed with Hyperdrive.
HIVE_API_BASE=https://api.hornethive.io/v1
HIVE_DB_ID=
HIVE_DDL_KEY=
HIVE_DML_KEY=
HIVE_READ_KEY=
