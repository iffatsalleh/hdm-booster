# Direct pooled Postgres string (PgBouncer, port 6432, sslmode=require). Used by migrations, DB tests and as the
# Hyperdrive origin (`wrangler hyperdrive create ... --connection-string="$HIVE_PG_URL" --caching-disabled`).
HIVE_PG_URL=
# Optional: HornetHive REST fallback only (the Worker uses these when no HYPERDRIVE binding is configured).
HIVE_API_BASE=https://api.hornethive.io/v1
HIVE_DB_ID=
HIVE_DDL_KEY=
HIVE_DML_KEY=
HIVE_READ_KEY=
