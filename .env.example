# Copy to .env for `npm run dev` against a dev Worker + Firebase project. Public values only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=hdm-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hdm-dev
VITE_API_URL=http://localhost:8787
VITE_GAS_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
# 1 = in-memory fake Firebase + Worker (src/mock). Use `npm run dev:mock` (reads .env.mock) instead of setting it here.
VITE_MOCK=
